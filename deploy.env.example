# Copy to .env (never commit .env) and fill in every value. Read by docker-compose.deploy.yml.

# The hostname reviewers open; it must point at this VM's public IP. With no domain of your own, use the free
# <public-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
SETUHAUL_DOMAIN=

# Database password (letters and digits only, 24+ characters). Generate: openssl rand -hex 16
SETUHAUL_DB_PASSWORD=

# Signs the sign-in sessions (32+ characters). Generate: openssl rand -hex 32
SETUHAUL_SESSION_SECRET=

# Demo accounts, "email:password" separated by commas (passwords 10+ characters, no commas).
SETUHAUL_DEMO_ACCOUNTS=

# Optional: API keys for driver agents (a WhatsApp bot), "name:key" separated by commas, keys 32+ characters.
# Generate a key: openssl rand -hex 24. Leave unset to allow only signed-in users on /api/agent/*.
# SETUHAUL_AGENT_KEYS=whatsapp:

# Optional: nightly reset time (IST) and load-test size.
# SETUHAUL_RESET_AT=03:00
# SETUHAUL_SCENARIO_TRUCKS=70
# SETUHAUL_SCENARIO_TRICKLE=20
